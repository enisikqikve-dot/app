{
  "name": "enis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "eNis – ein Lebens-Simulator im Browser, in dem du ein unsichtbarer Gott bist.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
